# --- Бэкенд ---
# Обязательна: без своего ключа контейнер не запустится. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=замените-на-случайное-значение
# Прежние ключи при смене SECRET_KEY, через запятую (docs/20-deploy-cloud.md, раздел 7)
SECRET_KEY_FALLBACKS=
# Любой секрет можно передать файлом вместо переменной: SECRET_KEY_FILE,
# SECRET_KEY_FALLBACKS_FILE, DATABASE_URL_FILE, DEMO_DATABASE_URL_FILE,
# EMAIL_HOST_PASSWORD_FILE, OIDC_CLIENT_SECRET_FILE, ADMIN_PASSWORD_FILE.
# Файл сильнее переменной; указанный, но нечитаемый файл останавливает запуск.
# Предел попыток входа по паролю и по ссылке с одного адреса
LOGIN_RATE=10/min
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://vacation:vacation@localhost:5432/vacation
# TLS к базе. Пусто — поведение libpq по умолчанию (prefer): локально так и надо.
# Управляемая база в облаке: DB_SSLMODE=verify-full и путь к корневому
# сертификату провайдера (монтируется в контейнер, в образ не вшивается).
# Те же параметры можно дописать в DATABASE_URL: ?sslmode=verify-full&sslrootcert=...
DB_SSLMODE=
DB_SSLROOTCERT=
PORT=8000

CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# --- HTTPS и cookies (production) ---
# Cookies только по HTTPS; по умолчанию — при DEBUG=False. Локально по
# http://localhost — False (docker compose так и делает).
SECURE_COOKIES=
# Срок HSTS в секундах. 0 — выключено; 31536000 — после проверки, что домен
# стабильно работает по HTTPS (браузер запомнит заголовок на весь срок).
SECURE_HSTS_SECONDS=0
# Редирект на HTTPS в Django; обычно его делает балансировщик.
SECURE_SSL_REDIRECT=False
# Время жизни сессии админки, секунды (12 часов)
SESSION_COOKIE_AGE=43200
# Осознанно принятые предупреждения check --deploy, через запятую
SILENCED_SYSTEM_CHECKS=

# 0 отключает миграции при старте (Kubernetes: выносятся в отдельный Job)
RUN_MIGRATIONS=1

# --- Первый администратор (docs/14-initial-admin.md) ---
# Создаётся при старте контейнера, если пользователя с такой почтой ещё нет.
# Существующего пользователя команда не меняет: ни пароль, ни права.
# Пароль проверяется штатными валидаторами Django: слабый остановит запуск.
# Обе переменные пусты — администратор не создаётся.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Необязательные: у модели сотрудника эти поля обязательны,
# без них подставляются значения по умолчанию.
ADMIN_FULL_NAME=Администратор
ADMIN_EMPLOYEE_NUMBER=ADMIN-0001
# ГГГГ-ММ-ДД, пусто — сегодняшняя дата
ADMIN_HIRE_DATE=

# --- Демо-режим (docs/15-demo-mode.md) ---
# Кнопка «Демо-режим» на экране входа: вымышленная компания на 157 человек,
# вход выбором роли без пароля. Данные — в отдельной базе, рабочих не касаются,
# и загружаются заново при каждом старте контейнера.
# Выключено: на публичном адресе любой посетитель войдёт в демо без пароля.
# Включайте, только если демо там действительно нужно.
DEMO_MODE_ENABLED=False
# Пусто — SQLite во временном каталоге контейнера (одна реплика).
# Для нескольких реплик — отдельная база Postgres, не та же, что DATABASE_URL.
DEMO_DATABASE_URL=
# 0 — не загружать при старте (общая демо-база, загрузка отдельным Job)
DEMO_LOAD_ON_START=1
# Ежедневный сброс демо в DEMO_RESET_TIME (ЧЧ:ММ по Москве). 0 — выключить
# (при общей демо-базе на несколько реплик сброс делает CronJob).
DEMO_RESET_DAILY=1
DEMO_RESET_TIME=00:00

# --- Фронтенд ---
# Пусто для Docker и Kubernetes: обращение к API идёт относительным путём,
# nginx проксирует /api на бэкенд. Заполняется только там, где фронтенд
# и бэкенд живут на разных доменах (Railway).
VITE_API_BASE_URL=
FRONTEND_PORT=8080
# Админка Django через nginx фронтенда. Путь — без слешей, одинаковый
# для бэкенда и фронтенда. Адреса/подсети через запятую; пусто — 403 всем.
DJANGO_ADMIN_PATH=admin
ADMIN_ALLOW_CIDRS=
# Прокси перед nginx фронтенда (балансировщик), которым верим в
# X-Forwarded-For. Пусто — значение образа: частные сети (Railway,
# Kubernetes, docker). На production — подсети балансировщика платформы.
TRUSTED_PROXY_CIDRS=
# Заголовок Strict-Transport-Security у nginx фронтенда, секунды; 0 — выключен.
# Включать вместе с SECURE_HSTS_SECONDS бэкенда, после проверки домена.
HSTS_MAX_AGE=0
# Адрес API для CSP, если он на другом домене (VITE_API_BASE_URL)
CSP_CONNECT_SRC=
# Предел запросов ко входу с одного адреса у nginx и допустимый всплеск
AUTH_RATE_LIMIT=30r/m
AUTH_RATE_BURST=10

# --- Postgres для docker compose ---
POSTGRES_DB=vacation
POSTGRES_USER=vacation
POSTGRES_PASSWORD=vacation

# --- Почтовые уведомления (docs/12-mail-setup.md) ---
MAIL_NOTIFICATIONS_ENABLED=False
APP_BASE_URL=
DEFAULT_FROM_EMAIL=vacation@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Без EMAIL_HOST письма печатаются в журнал контейнера.
# Отправка по расписанию внутри контейнера бэкенда (одна реплика).
# 0 — выключить (Kubernetes: отправляют CronJob, deploy/k8s/cronjobs.yaml).
MAIL_SCHEDULER=1
MAIL_SEND_INTERVAL_MINUTES=5
MAIL_DIGEST_TIME=09:00

# --- Доменная аутентификация (docs/11-sso-setup.md) ---
SSO_ALLOW_PASSWORD_LOGIN=True
# Kerberos: нужен образ, собранный с --build-arg WITH_KERBEROS=1
KERBEROS_ENABLED=False
KRB5_KTNAME=
KERBEROS_REALM_MAP=
KERBEROS_EMAIL_DOMAIN=
# Keycloak (OpenID Connect)
OIDC_ENABLED=False
OIDC_SERVER_URL=
OIDC_REALM=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# --- Резервные копии (docker compose, сервис backup; docs/16-backups.md) ---
# Каталог на хосте, куда складываются копии. Держите его на другом диске
# или копируйте дальше: копия на том же диске не спасёт от отказа диска.
BACKUP_HOST_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24
