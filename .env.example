# --- Бэкенд ---
SECRET_KEY=замените-на-случайное-значение
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://vacation:vacation@localhost:5432/vacation
PORT=8000

CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# 0 отключает миграции при старте (Kubernetes: выносятся в отдельный Job)
RUN_MIGRATIONS=1

# --- Фронтенд ---
# Пусто для Docker и Kubernetes: обращение к API идёт относительным путём,
# nginx проксирует /api на бэкенд. Заполняется только там, где фронтенд
# и бэкенд живут на разных доменах (Railway).
VITE_API_BASE_URL=
FRONTEND_PORT=8080

# --- Postgres для docker compose ---
POSTGRES_DB=vacation
POSTGRES_USER=vacation
POSTGRES_PASSWORD=vacation

# --- Почтовые уведомления (docs/12-mail-setup.md) ---
MAIL_NOTIFICATIONS_ENABLED=False
APP_BASE_URL=
DEFAULT_FROM_EMAIL=vacation@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Доменная аутентификация (docs/11-sso-setup.md) ---
SSO_ALLOW_PASSWORD_LOGIN=True
KRB5_KTNAME=
OIDC_SERVER_URL=
OIDC_REALM=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
