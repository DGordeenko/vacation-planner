# --- Бэкенд ---
SECRET_KEY=замените-на-случайное-значение
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://vacation:vacation@localhost:5432/vacation
PORT=8000

CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# 0 отключает миграции при старте (Kubernetes: выносятся в отдельный Job)
RUN_MIGRATIONS=1

# --- Первый администратор (docs/14-initial-admin.md) ---
# Создаётся при старте контейнера, если пользователя с такой почтой ещё нет.
# Существующего пользователя команда не меняет: ни пароль, ни права.
# Пароль проверяется штатными валидаторами Django: слабый остановит запуск.
# Обе переменные пусты — администратор не создаётся.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Необязательные: у модели сотрудника эти поля обязательны,
# без них подставляются значения по умолчанию.
ADMIN_FULL_NAME=Администратор
ADMIN_EMPLOYEE_NUMBER=ADMIN-0001
# ГГГГ-ММ-ДД, пусто — сегодняшняя дата
ADMIN_HIRE_DATE=

# --- Демо-режим (docs/15-demo-mode.md) ---
# Кнопка «Демо-режим» на экране входа: вымышленная компания на 157 человек,
# вход выбором роли без пароля. Данные — в отдельной базе, рабочих не касаются,
# и загружаются заново при каждом старте контейнера.
# Выключено: на публичном адресе любой посетитель войдёт в демо без пароля.
# Включайте, только если демо там действительно нужно.
DEMO_MODE_ENABLED=False
# Пусто — SQLite во временном каталоге контейнера (одна реплика).
# Для нескольких реплик — отдельная база Postgres, не та же, что DATABASE_URL.
DEMO_DATABASE_URL=
# 0 — не загружать при старте (общая демо-база, загрузка отдельным Job)
DEMO_LOAD_ON_START=1
# Ежедневный сброс демо в DEMO_RESET_TIME (ЧЧ:ММ по Москве). 0 — выключить
# (при общей демо-базе на несколько реплик сброс делает CronJob).
DEMO_RESET_DAILY=1
DEMO_RESET_TIME=00:00

# --- Фронтенд ---
# Пусто для Docker и Kubernetes: обращение к API идёт относительным путём,
# nginx проксирует /api на бэкенд. Заполняется только там, где фронтенд
# и бэкенд живут на разных доменах (Railway).
VITE_API_BASE_URL=
FRONTEND_PORT=8080

# --- Postgres для docker compose ---
POSTGRES_DB=vacation
POSTGRES_USER=vacation
POSTGRES_PASSWORD=vacation

# --- Почтовые уведомления (docs/12-mail-setup.md) ---
MAIL_NOTIFICATIONS_ENABLED=False
APP_BASE_URL=
DEFAULT_FROM_EMAIL=vacation@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Доменная аутентификация (docs/11-sso-setup.md) ---
SSO_ALLOW_PASSWORD_LOGIN=True
KRB5_KTNAME=
OIDC_SERVER_URL=
OIDC_REALM=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
