# Что не должно попасть в образ: локальные данные, секреты, тесты.
# Образ публикуется в реестр, и всё, что в нём лежит, доступно каждому,
# кто может его скачать.

# Секреты и локальные настройки (любые .env*, ключи и сертификаты)
.env
.env.*
*.keytab
*.pem
*.key
*.crt

# Локальные базы и данные: в них могут быть настоящие персональные данные
db.sqlite3
*.sqlite3
testdata/
*.dump
backups/

# Тесты и инструменты разработки: в рабочем контейнере не нужны
**/tests.py
**/tests_*.py
requirements-dev.txt
.coverage
htmlcov/
.ruff_cache/

# Сборочный мусор
__pycache__/
*.py[cod]
.venv/
venv/
staticfiles/
.git
