# Схема исходного запроса. TLS обычно завершается на балансировщике
# платформы, и для nginx запрос приходит по HTTP: $scheme дал бы «http»,
# Django считал бы соединение незащищённым (ссылки http://, secure-cookie
# не работают). Поэтому заголовок балансировщика передаётся дальше, а если
# его нет — подставляется своя схема.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# Защита входа от перебора: запросов в минуту с одного адреса (адрес —
# уже после realip). Django ограничивает попытки входа своим счётчиком,
# но в памяти каждой реплики; nginx отсекает поток раньше, не нагружая
# бэкенд. AUTH_RATE_LIMIT, AUTH_RATE_BURST — в Dockerfile.
# Журнал запросов без строки запроса и без Referer:
# в ссылке-приглашении (?invite=…) и при возврате из Keycloak (?code=…)
# там токены, а журналы хранятся дольше и доступны шире, чем база.
# Путь — из исходного запроса до «?»: $uri после try_files был бы /index.html.
map $request_uri $request_path {
    "~^(?<path>[^?]*)" $path;
}
log_format noquery '$remote_addr "$request_method $request_path $server_protocol" '
                   '$status $body_bytes_sent $request_time "$http_user_agent"';

limit_req_zone $binary_remote_addr zone=auth:10m rate=${AUTH_RATE_LIMIT};
limit_req_status 429;

server {
    listen       ${PORT};
    server_tokens off;
    access_log /dev/stdout noquery;   # версия nginx в ответах — подсказка для поиска уязвимостей
    # Самая большая загрузка — кадровая выгрузка; больше — ошибка 413.
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    server_name  _;
    root         /usr/share/nginx/html;

    # Адрес клиента: из X-Forwarded-For, но только от доверенных прокси
    # (TRUSTED_PROXY_CIDRS, файл собирает docker-entrypoint.d/16-*).
    include /etc/nginx/conf.d/trusted-proxies.inc;

    # Адрес бэкенда разрешается при каждом запросе, а не один раз при старте.
    # Иначе nginx запоминает IP бэкенда, и после его пересборки (на Railway
    # адрес меняется) запросы к /api/ уходят на старый адрес до перезапуска
    # фронтенда. NGINX_LOCAL_RESOLVERS образ nginx берёт из /etc/resolv.conf
    # (включается NGINX_ENTRYPOINT_LOCAL_RESOLVERS в Dockerfile).
    # ipv6=off обязателен: DNS Railway отдаёт и IPv6-адрес, а gunicorn
    # слушает только IPv4 (0.0.0.0) — запрос на IPv6 висел бы до таймаута.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Адрес через переменную — тоже ради разрешения при каждом запросе;
    # заодно nginx стартует, даже если бэкенд ещё не поднят. BACKEND_URL
    # задаётся без пути и без завершающего «/»: с переменной nginx передаёт
    # путь запроса как есть, а путь в адресе заменил бы его целиком.
    set $backend "${BACKEND_URL}";

    # SPA: любой маршрут отдаёт index.html, маршрутизация на клиенте.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri $uri/ /index.html;
    }

    # index.html — каждый раз проверять: в нём ссылки на файлы новой версии.
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
    }

    # Файлы сборки Vite: в имени хеш содержимого, новая версия — новое имя.
    # Кэш на год, без перепроверки.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Вход по паролю, по ссылке-приглашению, демо и начало доменного входа.
    location ~ ^/api/v1/auth/(login|accept-invitation|demo-login|oidc/start|negotiate)/ {
        limit_req zone=auth burst=${AUTH_RATE_BURST} nodelay;
        include /etc/nginx/conf.d/security-headers.inc;
        include /etc/nginx/snippets/proxy.inc;
    }

    # Проксирование на бэкенд: фронтенд и API живут на одном домене,
    # поэтому CORS не нужен. Для площадок с разными доменами
    # используется VITE_API_BASE_URL, и этот блок не задействуется.
    # Бэкенду передаётся один адрес — клиента, уже проверенный выше, а не
    # цепочка от клиента: $proxy_add_x_forwarded_for дописывал бы к
    # присланному клиентом заголовку, и подделка доходила бы до Django.
    location /api/ {
        include /etc/nginx/conf.d/security-headers.inc;
        include /etc/nginx/snippets/proxy.inc;
    }

    # Админка Django. Без этого блока /admin/ уходил в SPA и показывал
    # пустой интерфейс. Открыта только адресам из ADMIN_ALLOW_CIDRS
    # (файл собирает docker-entrypoint.d/15-admin-allow.sh), остальным — 403.
    # Путь настраивается (DJANGO_ADMIN_PATH) и должен совпадать с бэкендом.
    location /${DJANGO_ADMIN_PATH}/ {
        include            /etc/nginx/conf.d/admin-allow.inc;
        include /etc/nginx/conf.d/security-headers.inc;
        include /etc/nginx/snippets/proxy.inc;
    }

    # Статика админки Django (WhiteNoise в бэкенде).
    location /static/ {
        include /etc/nginx/conf.d/security-headers.inc;
        include /etc/nginx/snippets/proxy.inc;
    }

    gzip              on;
    gzip_types        text/css application/javascript application/json image/svg+xml;
    gzip_min_length   1024;
}
